# Copy to .env and adjust. All of these have working defaults — nothing is required
# to run the backend, but tide will use a documented fallback constant unless you set
# WORLDTIDES_API_KEY (see app/weather_service.py).

# Point location used for the live rainfall API call (Open-Meteo, no key needed).
ANDHERI_LAT=19.1197
ANDHERI_LON=72.8468

# How often (seconds) the background poller refreshes live weather + recomputes risk.
WEATHER_POLL_INTERVAL_SECONDS=300

# How often (seconds) tide specifically refreshes — independent of rainfall, and much
# slower by default, since WorldTides' free tier has a tight monthly call quota and
# tides don't change on a 5-minute timescale. Default: 1800 (30 min).
TIDE_POLL_INTERVAL_SECONDS=1800

# Optional: https://www.worldtides.info free-tier API key, for real tide extremes.
# Leave blank to use the documented fallback constant (max_tide_height_m=1.1, 0 highs).
WORLDTIDES_API_KEY=

# CORS: set to your deployed frontend's origin in production, e.g. https://your-app.com
# Defaults to "*" (any origin) for local development.
FRONTEND_ORIGIN=*
