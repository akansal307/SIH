# Base URL of the real flood-nowcast backend (see README.md "API Contract").
#
# Leave this UNSET (or empty) to run entirely on the bundled mock data generated by
# scripts/generate_scenarios.py — this is the default and is what the deployed demo
# uses. The app never hard-codes localhost or any other URL anywhere in src/; every
# API call reads from this single variable (src/api/client.ts).
#
# Once a real backend exists, copy this file to .env.local and set:
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=
